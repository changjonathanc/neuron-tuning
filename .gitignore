!demos/plays_dumb_ml/columns_lr0.01_s0.safetensors

# 11 blind audit: the corpus is rebuilt by corpus.py (public dataset text, SHA-256 checked)
experiments/11_blind_audit/data/corpus.json
!demos/narrow_policy/columns_lr0.003_s0.safetensors
